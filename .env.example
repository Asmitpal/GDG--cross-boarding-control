# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://crossboarding:crossboarding_secret@localhost:5432/crossboarding

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API Server ───────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Auth ─────────────────────────────────────────────────
# Shared secret — send as X-API-Key header from frontend
API_KEY=dev-secret-key-change-in-prod

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Slack Integration ────────────────────────────────────
# Leave blank to use mock (console.log) mode
SLACK_WEBHOOK_URL=

# ─── Okta Integration ─────────────────────────────────────
OKTA_DOMAIN=
OKTA_API_TOKEN=

# ─── GitHub Integration ───────────────────────────────────
GITHUB_ORG=
GITHUB_TOKEN=
